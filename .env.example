# Public origin. Set your real HTTPS custom domain for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Project Settings > API (not passwords).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_. Required for the durable limiter
# and admin provisioning, never used for public inventory reads.
SUPABASE_SERVICE_ROLE_KEY=

# Generate at least 32 random bytes locally; never commit the actual value.
RATE_LIMIT_SECRET=

# OFF by default. Aggregate events only, no cookies or raw search terms.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Optional public mailbox for corrections/privacy requests. No fake contact seeded.
NEXT_PUBLIC_CONTACT_EMAIL=

# Local development only: explicitly enables synthetic test fixtures, NOT inventory.
# Rejected on Vercel and when Supabase is configured. Never set for deployment.
SHAGUN_TEST_FIXTURES=false