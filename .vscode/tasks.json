{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Shagun: Local app preview",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"start",
				"--",
				"--hostname",
				"localhost"
			],
			"options": {
				"env": {
					"SHAGUN_TEST_FIXTURES": "false"
				}
			},
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Shagun: Verify",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"check"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Shagun: Inspect shared database",
			"type": "shell",
			"command": "node",
			"args": [
				"--use-system-ca",
				"./node_modules/tsx/dist/cli.mjs",
				"scripts/db-migrate.ts",
				"--source-env",
				"../biharibhojan/.env",
				"--expected-project-ref",
				"ixkhyqqovacdramymqjk"
			],
			"options": {
				"env": {
					"NODE_EXTRA_CA_CERTS": "${workspaceFolder}/.qa/supabase-production-ca.crt"
				}
			},
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Shagun: Download public database CA",
			"type": "shell",
			"command": "Invoke-WebRequest",
			"args": [
				"-Uri",
				"https://supabase-downloads.s3-ap-southeast-1.amazonaws.com/prod/ssl/prod-ca-2021.crt",
				"-OutFile",
				".qa/supabase-production-ca.crt"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Shagun: Diagnose database permissions",
			"type": "shell",
			"command": "node",
			"args": [
				"--use-system-ca",
				"./node_modules/tsx/dist/cli.mjs",
				"scripts/db-access-inspect.ts",
				"--source-env",
				"../biharibhojan/.env",
				"--expected-project-ref",
				"ixkhyqqovacdramymqjk"
			],
			"options": {
				"env": {
					"NODE_EXTRA_CA_CERTS": "${workspaceFolder}/.qa/supabase-production-ca.crt"
				}
			},
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Shagun: Build app preview",
			"type": "shell",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"options": {
				"env": {
					"SHAGUN_TEST_FIXTURES": "false"
				}
			},
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Shagun: Check hosted workflow",
			"type": "shell",
			"command": "gh",
			"args": [
				"api",
				"repos/RichardHenryJames/shagun/actions/runs",
				"--jq",
				".workflow_runs[:3] | map({head_sha,status,conclusion,html_url})"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Shagun: Create encrypted local backup",
			"type": "shell",
			"command": "node",
			"args": [
				"--use-system-ca",
				"./node_modules/tsx/dist/cli.mjs",
				"scripts/db-backup-current.ts",
				"--source-env",
				"../biharibhojan/.env",
				"--expected-project-ref",
				"ixkhyqqovacdramymqjk",
				"--recovery-owner",
				"Parimal"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}